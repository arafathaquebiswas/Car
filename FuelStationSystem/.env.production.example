# ==============================================================================
# Hostinger Shared Hosting Production Environment Template
# Subdomain: https://fuel.atmabiswas.org/
# Place this file as `.env` in your project root on Hostinger
# ==============================================================================

# Server Environment
PORT=4000
NODE_ENV=production

# Hostinger MySQL Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_fuel_user
DB_PASSWORD=YourStrongDatabasePassword123!
DB_NAME=u123456789_fuel_db
DB_CONNECTION_LIMIT=5

# Auth & Security JWT (Generate a 64-char random hex: openssl rand -hex 32)
JWT_SECRET=e7b4f8a9c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8
JWT_EXPIRES_IN=8h

# Seed Admin Credentials (Used ONLY on first boot if no users exist)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=SetSecureAdminPasswordHere!
SEED_ADMIN_NAME=System Administrator

# Upload Limits
MAX_UPLOAD_MB=12

# System Email Sender
SYSTEM_EMAIL_FROM=noreply@atmabiswas.org

# Allowed Origins (Same-origin only for fuel.atmabiswas.org)
CORS_ORIGIN=https://fuel.atmabiswas.org
