# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fuel_station

# --- Auth ---
# Any long random string. Example generator: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=8h

# --- Seed admin account (used only the first time the app finds no users) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Administrator

# --- Uploads ---
MAX_UPLOAD_MB=12

# --- CORS (comma-separated list of allowed origins, blank = same-origin only) ---
CORS_ORIGIN=
